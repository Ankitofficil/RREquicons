# Copy to .env.local for local dev. On Hostinger, set these in
# hPanel → Websites → Node.js → Environment Variables (NOT in a committed file).

# --- Public site URL ---
# Canonical origin, no trailing slash. Used for canonical tags, Open Graph
# images, robots.txt and sitemap.xml. Must be the real production domain or
# search engines will index the wrong URLs.
NEXT_PUBLIC_SITE_URL=https://rrequiconspvtltd.com

# --- Admin panel (/admin) ---
# Without ADMIN_PASSWORD the panel cannot be logged into at all.
# Use a long, random password — it is the only credential.
ADMIN_PASSWORD=

# Signs the session cookie (16+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Content is stored by committing to GitHub, which triggers a redeploy —
# that is what makes admin changes survive rebuilds. Without these, edits
# only touch the local filesystem and are lost on the next deploy.
#   GITHUB_TOKEN  a fine-grained PAT with Contents: Read and write on this repo
#   GITHUB_REPO   owner/name
GITHUB_TOKEN=
GITHUB_REPO=Ankitofficil/RREquicons
GITHUB_BRANCH=main

# --- Analytics ---
# Google Analytics 4 measurement ID. Defaults to the site's own ID, so this
# only needs setting to point at a different property — or to "" to switch
# analytics off. Read at BUILD time; analytics only loads in production
# builds, so `next dev` never reports traffic.
# NEXT_PUBLIC_GA_ID=G-CG9ZX6V7LX

# --- Server ---
# Hostinger assigns the port; its Node manager usually injects PORT itself.
# Only set these if you run the server manually.
# PORT=3000
# HOSTNAME=0.0.0.0
NODE_ENV=production

# --- Contact form email delivery (SMTP via Nodemailer) ---
# Requires a Node server (this app runs `node server.js`). Without these the
# /api/contact route returns 503 and the forms show a friendly error.

# Option A) Hostinger email (recommended — same host, no extra setup)
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_USER=info@rrequiconspvtltd.com
#   SMTP_PASS=<mailbox password>

# Option B) Google Workspace (Gmail on your domain)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=info@rrequiconspvtltd.com
#   SMTP_PASS=<16-char App Password>   # requires 2-Step Verification

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Sender shown on the email. Usually the same mailbox as SMTP_USER.
# e.g. "R R Equicons <info@rrequiconspvtltd.com>". Defaults to SMTP_USER.
CONTACT_FROM_EMAIL=

# Where form submissions are delivered. Defaults to info@rrequiconspvtltd.com.
CONTACT_TO_EMAIL=
