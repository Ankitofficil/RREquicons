# Contact form email delivery (SMTP via Nodemailer)
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
#
# Requires running the app on a Node server (`next start`) — Hostinger Node.js /
# VPS, or Vercel. Pure static hosting cannot run the /api/contact route.

# --- Choose ONE mail provider ---

# Option A) Google Workspace (Gmail on your domain)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=info@yourdomain.com
#   SMTP_PASS=<16-char App Password>   # Google Account → Security → App passwords
#                                       # (requires 2-Step Verification enabled)

# Option B) Hostinger email
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_USER=info@yourdomain.com
#   SMTP_PASS=<your mailbox password>

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Sender shown on the email. Usually the same mailbox as SMTP_USER.
# e.g. "R R Equicons <info@yourdomain.com>". Defaults to SMTP_USER if unset.
CONTACT_FROM_EMAIL=

# Where form submissions are delivered. Defaults to info@rrequiconspvtltd.com.
CONTACT_TO_EMAIL=
